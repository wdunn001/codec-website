# Copy to .env on the deploy host and adjust as needed.
# These map to environment variables consumed by docker-compose.yml.

# Comma-separated hostnames the jwilder proxy should route to this container,
# and the same list as the cert SAN. EVERY hostname listed here MUST resolve
# in DNS before bringing the container up; acme.sh issues multi-SAN certs
# atomically, so a single NXDOMAIN tanks the whole cert.
PROXY_CODEC_HOSTS=codecai.net

# Email used by Let's Encrypt for cert expiry notifications.
LETSENCRYPT_EMAIL=licensing@quasarke.com

# External Docker network shared with jwilder/nginx-proxy + letsencrypt-companion.
# Default matches the masszerofpv setup on the same host.
NGINX_PROXY_NETWORK=nginx-proxy
