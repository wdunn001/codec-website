---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";

const all = await getCollection("docs");
const frameworks = all
  .filter((e) => e.data.section === "Frameworks")
  .sort((a, b) => a.data.order - b.data.order);
const start = all
  .filter((e) => e.data.section === "Start")
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="Codec docs — wire format, walkthroughs, references" description="Documentation for Codec: a token-native binary transport protocol for AI APIs. Quickstarts and integration walkthroughs for TypeScript, Python, .NET, C, Rust, Java, and sglang.">
  <div class="docs-shell container">
    <DocsSidebar currentSlug="" />

    <article class="docs-article">
      <header class="docs-head">
        <h1 class="docs-title">Codec docs</h1>
        <p class="docs-desc">
          Codec is a token-native binary transport protocol for AI APIs.
          The six reference implementations ship matching APIs &mdash; pick
          your runtime and skip to the walkthrough.
        </p>
      </header>

      <section class="docs-cards">
        <h2 class="docs-cards__heading">Get started</h2>
        <div class="docs-cards__grid docs-cards__grid--2">
          {start.map((e) => (
            <a class="docs-card" href={`/docs/${e.id}/`}>
              <div class="docs-card__title">{e.data.title}</div>
              {e.data.description && <p class="docs-card__desc">{e.data.description}</p>}
            </a>
          ))}
        </div>
      </section>

      <section class="docs-cards">
        <h2 class="docs-cards__heading">Pick your runtime</h2>
        <div class="docs-cards__grid">
          {frameworks.map((e) => (
            <a class={`docs-card${e.data.status === "draft" ? " docs-card--draft" : ""}`} href={`/docs/${e.id}/`}>
              <div class="docs-card__title">
                {e.data.title}
                {e.data.status === "draft" && <span class="docs-card__pill">draft</span>}
              </div>
              {e.data.description && <p class="docs-card__desc">{e.data.description}</p>}
            </a>
          ))}
        </div>
      </section>

      <section class="docs-cards">
        <h2 class="docs-cards__heading">Source &amp; spec</h2>
        <ul class="docs-links">
          <li><a href="https://github.com/wdunn001/Codec" rel="noopener">github.com/wdunn001/Codec</a> &mdash; protocol + six reference implementations</li>
          <li><a href="https://github.com/wdunn001/codec-maps" rel="noopener">github.com/wdunn001/codec-maps</a> &mdash; pre-generated tokenizer dialect maps for common models (open to contributions)</li>
          <li><a href="https://www.npmjs.com/package/@codecai/maps-cli" rel="noopener">@codecai/maps-cli</a> &mdash; generate a map for any model with a <code>tokenizer.json</code></li>
          <li><a href="/docs/wire-compress/">@codecai/wire-compress</a> &mdash; HTTP compression picker (gzip / brotli / dict-zstd / identity) used by every Codec server + client</li>
          <li><a href="https://github.com/wdunn001/Codec/blob/main/spec/PROTOCOL.md" rel="noopener">PROTOCOL.md</a> &mdash; the canonical wire spec</li>
          <li><a href="https://github.com/wdunn001/Codec/blob/main/RESULTS.md" rel="noopener">RESULTS.md</a> &mdash; live benchmark numbers</li>
        </ul>
      </section>
    </article>
  </div>

  <style>
    .docs-shell {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 2rem;
      padding-bottom: 4rem;
    }
    @media (min-width: 880px) {
      .docs-shell {
        grid-template-columns: 240px minmax(0, 1fr);
        gap: 3rem;
      }
    }

    .docs-article { min-width: 0; max-width: 740px; }
    .docs-head { margin-bottom: 2.5rem; }
    .docs-title {
      font-size: clamp(1.875rem, 4vw, 2.5rem);
      letter-spacing: -0.02em;
      margin: 0 0 0.5rem;
    }
    .docs-desc { color: var(--fg-muted); max-width: 60ch; margin: 0; }

    .docs-cards { margin-bottom: 2.5rem; }
    .docs-cards__heading {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--fg-faint);
      margin: 0 0 0.875rem;
      font-weight: 500;
    }
    .docs-cards__grid {
      display: grid;
      gap: 0.625rem;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    }
    .docs-cards__grid--2 { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }

    .docs-card {
      display: block;
      padding: 1rem 1.125rem;
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--fg);
      transition: border-color 120ms, transform 120ms;
    }
    .docs-card:hover {
      border-color: var(--data);
      transform: translateY(-1px);
    }
    .docs-card__title {
      font-family: var(--font-mono);
      font-weight: 600;
      letter-spacing: -0.01em;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .docs-card__desc {
      margin: 0.375rem 0 0;
      color: var(--fg-muted);
      font-size: 0.875rem;
      line-height: 1.5;
    }
    .docs-card__pill {
      font-family: var(--font-mono);
      font-size: 0.625rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--fg-faint);
      border: 1px solid var(--border);
      padding: 0 0.375rem;
      border-radius: 4px;
    }
    .docs-card--draft { border-style: dashed; }

    .docs-links {
      list-style: none;
      padding: 0;
      margin: 0;
      font-family: var(--font-mono);
      font-size: 0.875rem;
      color: var(--fg-muted);
    }
    .docs-links li { padding: 0.375rem 0; }
    .docs-links a { color: var(--data); border-bottom: 1px dotted var(--border-strong); }
  </style>
</Base>
