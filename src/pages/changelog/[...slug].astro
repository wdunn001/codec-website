---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const entries = await getCollection("changelog");
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const kindLabel: Record<"feature" | "improvement" | "fix", string> = {
  feature: "feature",
  improvement: "improvement",
  fix: "fix",
};
---
<Base
  title={`${entry.data.title} | Codec`}
  description={entry.data.summary}
>
  <article class="container changelog-entry">
    <p class="changelog-entry__back"><a href="/changelog/">&larr; What's new</a></p>
    <header class="changelog-entry__head">
      <div class="changelog-entry__meta">
        <time datetime={entry.data.date}>{entry.data.date}</time>
        <span class={`changelog__chip changelog__chip--${entry.data.kind}`}>
          {kindLabel[entry.data.kind]}
        </span>
        {entry.data.version && <span class="changelog__version">{entry.data.version}</span>}
      </div>
      <h1>{entry.data.title}</h1>
      <p class="changelog-entry__summary">{entry.data.summary}</p>
    </header>

    <div class="changelog-entry__body">
      <Content />
    </div>

    {entry.data.links.length > 0 && (
      <footer class="changelog-entry__footer">
        <h2>Links</h2>
        <ul>
          {entry.data.links.map((l) => (
            <li><a href={l.url} rel="noopener">{l.label}</a></li>
          ))}
        </ul>
      </footer>
    )}
  </article>
</Base>

<style>
  .changelog-entry { padding: 3rem 0 5rem; max-width: 720px; }
  .changelog-entry__back {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-muted);
    margin: 0 0 1rem;
  }
  .changelog-entry__back a { color: var(--fg-muted); }
  .changelog-entry__back a:hover { color: var(--fg); }
  .changelog-entry__head { margin-bottom: 1.5rem; }
  .changelog-entry__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-faint);
    margin-bottom: 0.5rem;
  }
  .changelog__chip {
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.6875rem;
  }
  .changelog__chip--feature {
    background: color-mix(in srgb, var(--data) 18%, transparent);
    color: var(--data);
  }
  .changelog__chip--improvement {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    color: var(--accent);
  }
  .changelog__chip--fix {
    background: color-mix(in srgb, var(--fg-muted) 22%, transparent);
    color: var(--fg);
  }
  .changelog__version { color: var(--fg-muted); }
  .changelog-entry h1 {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    margin: 0 0 0.5rem;
  }
  .changelog-entry__summary {
    color: var(--fg-muted);
    margin: 0;
  }
  .changelog-entry__body { line-height: 1.65; }
  .changelog-entry__body :global(p) { margin: 0 0 1rem; }
  .changelog-entry__body :global(a) { color: var(--data); }
  .changelog-entry__footer { margin-top: 3rem; }
  .changelog-entry__footer h2 {
    font-family: var(--font-mono);
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }
  .changelog-entry__footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .changelog-entry__footer a { color: var(--fg-muted); }
  .changelog-entry__footer a:hover { color: var(--fg); }
</style>
