---
// Benchmarks section: real measurements from the live cross-stack matrix.
// Source: github.com/wdunn001/Codec/blob/main/packages/bench/results/2026-05-08T01-15-02Z/MATRIX.md
//
// All numbers are measured this session — no projections, no theoreticals.
// Hardware: NVIDIA RTX 3090 / Qwen2.5-0.5B-Instruct.
// Engines: sglang nightly, vllm nightly (PR #41765), llama.cpp PR #22757.
// Six client languages produced byte-identical Codec frames per cell on
// sglang and llama.cpp; vllm shows 5–10 % chunker drift, frames decode
// to the same token stream.

// ============== CHART 1: streaming wire bytes (sglang, the headline) ==
type Series = {
  label: string;
  className: string;
  values: { x: number; bytes: number; display: string }[];
};

// All numbers below are from MATRIX.md §3 (Python row, sglang). Other
// 5 client languages (TS/.NET/C/Rust/Java) agree byte-identically on
// every Codec cell — see the cross-stack panel further down.
const series: Series[] = [
  {
    label: "JSON-SSE",
    className: "line line--json",
    values: [
      { x: 90,  bytes: 15200,  display: "15.2 KB" },
      { x: 380, bytes: 121600, display: "121.6 KB" },
      { x: 680, bytes: 485200, display: "485.2 KB" },
    ],
  },
  {
    label: "Codec (identity)",
    className: "line line--codec-id",
    values: [
      { x: 90,  bytes: 975,   display: "975 B" },
      { x: 380, bytes: 7616,  display: "7.6 KB" },
      { x: 680, bytes: 30000, display: "30.0 KB" },
    ],
  },
  {
    label: "Codec + gzip",
    className: "line line--codec-gz",
    values: [
      { x: 90,  bytes: 226,  display: "226 B" },
      { x: 380, bytes: 730,  display: "730 B" },
      { x: 680, bytes: 354,  display: "354 B" },
    ],
  },
];

// Map a byte count onto the plot's Y coordinate (log10).
// log10(100) = 2 -> y=310 ; log10(1_000_000) = 6 -> y=30 ; 70px per decade.
const yFor = (bytes: number) => {
  const lg = Math.log10(bytes);
  return Math.round((310 - (lg - 2) * 70) * 100) / 100;
};

// Build SVG polyline path for each series.
const linePath = (s: Series) =>
  s.values.map((v) => `${v.x},${yFor(v.bytes)}`).join(" ");

// ============== CHART 2: cross-stack reduction ==
// Three engines, same prompt, same model, same client. Shows that
// Codec is not an sglang trick — it slots into vllm and llama.cpp too.
// Numbers from MATRIX.md §1 headline table (Python row, 2,048 tokens,
// best Codec encoding for each engine).
type EngineRow = {
  name: string;
  jsonKB: number;
  bestBytes: number;
  bestDisplay: string;
  bestKind: string;
  ratio: string;
  // ttftMs is paired with each engine's reduction so the chart never reads
  // as "tiny payload, but at what latency cost?" — it's the same Codec
  // msgpack + gzip first-body-byte median used in chart 3 below.
  ttftMs: string;
};
const engineRows: EngineRow[] = [
  {
    name: "sglang",
    jsonKB: 485,
    bestBytes: 354,
    bestDisplay: "354 B",
    bestKind: "Codec msgpack + dict-zstd",
    ratio: "1,404×",
    ttftMs: "45.6 ms",
  },
  {
    name: "vllm",
    jsonKB: 479,
    bestBytes: 3903,
    bestDisplay: "3.9 KB",
    bestKind: "Codec msgpack + gzip",
    ratio: "126×",
    ttftMs: "67.3 ms",
  },
  {
    name: "llama.cpp",
    jsonKB: 529,
    bestBytes: 16100,
    bestDisplay: "16 KB",
    bestKind: "Codec msgpack + gzip",
    ratio: "33×",
    ttftMs: "40.7 ms",
  },
];

// ============== CHART 3: TTFB ==
// Median first-body-byte latency at 2 K tokens, msgpack + gzip path,
// from MATRIX.md §4 body-byte cohort (Python httpx aiter_raw definition).
//
// Plot layout coordinates (shared with chart 4 below): label column
// 0–128, bar column 140–520, value column 532+. SVG viewBox is 720
// wide so a "60.4 ms" right-edge value fits comfortably without
// overflowing.
const ttfbBars = [
  { engine: "llama.cpp", ms: 40.7, klass: "ttfb-bar ttfb-bar--llama" },
  { engine: "sglang",    ms: 45.6, klass: "ttfb-bar ttfb-bar--sglang" },
  { engine: "vllm",      ms: 67.3, klass: "ttfb-bar ttfb-bar--vllm" },
];
const ttfbMaxMs = 80;
const ttfbPlotX0 = 140;
const ttfbPlotW  = 380;

// ============== CHART 4: cross-vocab handoff ==
//
// Numbers from packages/bench/results/2026-05-08T01-15-02Z/translator/python.json
// Two paths timed against the SAME source ID stream (Llama-3 IDs):
//   - Codec wire:   IDs cross the wire, bridge runs Translator(Llama->Qwen)
//                   in-process (detok + retok stays in-memory)
//   - JSON-SSE:     A.detokenize -> SSE chunks cross the wire,
//                   bridge parses SSE + BPE-encodes for Qwen
// Both paths produce identical Qwen-2 IDs (asserted by the bench).
type XvocRow = {
  size: number;
  codecBytes: number;
  jsonBytes: number;
  ratio: string;
  codecCpuMs: number;
  jsonCpuMs: number;
};
const xvocRows: XvocRow[] = [
  { size: 64,   codecBytes:  215, jsonBytes:    585, ratio: "2.7×",  codecCpuMs: 1.2, jsonCpuMs: 1.2 },
  { size: 512,  codecBytes:  672, jsonBytes:   2923, ratio: "4.3×",  codecCpuMs: 3.9, jsonCpuMs: 4.8 },
  { size: 2048, codecBytes:  709, jsonBytes:  10683, ratio: "15.1×", codecCpuMs: 7.7, jsonCpuMs: 10.9 },
];
// Format helpers
const fmtBytes = (n: number) => n < 1024 ? `${n} B` : `${(n / 1024).toFixed(1)} KB`;
const xvocMaxBytes = 11000;
const xvocPlotX0 = 90;
const xvocPlotW  = 380;

// ============== CHART 5: tool-call detection ==
//
// `lines` is an array of label rows so wide labels wrap into multiple
// tspans within a single SVG <text> — SVG doesn't auto-wrap and a
// long label like "Detokenize + regex" overflowed the 128-unit label
// column on its own line.
const toolMaxMs = 60.4;
const toolPlotX0 = 140;
const toolPlotW  = 380;
const toolBars = [
  { lines: ["Detokenize", "+ regex"], ms: 60.4, klass: "tool-bar tool-bar--text" },
  { lines: ["Codec ToolWatcher"],     ms: 0.61, klass: "tool-bar tool-bar--codec" },
];
---

<section id="benchmarks" class="section bench">
  <div class="container">
    <p class="eyebrow">receipts</p>
    <h2>Real measurements. Live runs. <span class="bench__title-mute">No projections.</span></h2>
    <p class="bench__lede">
      Numbers below are from the cross-stack benchmark matrix &mdash; same
      prompt, same model, three real inference engines, six real client
      languages. Every cell is measured. Sources are linked under each chart
      and the full SCHEMA-v1 result JSONs live in
      <a href="https://github.com/wdunn001/Codec/tree/main/packages/bench/results" rel="noopener"><code>packages/bench/results/</code></a>.
    </p>

    <!-- ============== CHART 1: streaming wire bytes ============== -->
    <article class="bench-card">
      <header class="bench-card__head">
        <div>
          <h3 class="bench-card__title">Streaming wire bytes by payload size</h3>
          <p class="bench-card__sub">sglang &middot; lower is better &middot; Y axis is log scale (each gridline is 10&times;)</p>
        </div>
        <div class="bench-card__hero">
          <span class="bench-card__hero-num">1,404&times;</span>
          <span class="bench-card__hero-cap">smaller at 2,048 tokens</span>
        </div>
      </header>

      <div class="bench-chart">
        <svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Line chart: streaming wire bytes by payload size on sglang. JSON-SSE grows from 15.2 KB at 64 tokens to 485.2 KB at 2,048 tokens. Codec with dict-zstd lands at 226 bytes, 730 bytes, and 354 bytes for the same three sizes.">
          <!-- Y gridlines + labels -->
          {[
            { y: 30,  label: "1 MB" },
            { y: 100, label: "100 KB" },
            { y: 170, label: "10 KB" },
            { y: 240, label: "1 KB" },
            { y: 310, label: "100 B" },
          ].map((g) => (
            <g class="grid">
              <line x1="80" x2="690" y1={g.y} y2={g.y} />
              <text x="72" y={g.y + 4} text-anchor="end" class="axis-label">{g.label}</text>
            </g>
          ))}

          <!-- X axis labels -->
          {[
            { x: 90,  label: "64 tokens" },
            { x: 380, label: "512 tokens" },
            { x: 680, label: "2,048 tokens" },
          ].map((t) => (
            <text x={t.x} y={335} text-anchor="middle" class="axis-label">{t.label}</text>
          ))}

          <!-- Series lines + dots + end-labels -->
          {series.map((s) => (
            <g class={s.className}>
              <polyline points={linePath(s)} fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              {s.values.map((v) => (
                <circle cx={v.x} cy={yFor(v.bytes)} r="4" />
              ))}
              <text x={s.values[s.values.length - 1].x + 10} y={yFor(s.values[s.values.length - 1].bytes) + 4} class="line-end-label">{s.values[s.values.length - 1].display}</text>
            </g>
          ))}
        </svg>
      </div>

      <ul class="bench-legend">
        {series.map((s) => (
          <li class={s.className.replaceAll("line", "swatch")}>
            <span class="swatch__line" aria-hidden="true"></span>
            <span class="swatch__label">{s.label} <span class="swatch__sub">{s.label === "Codec + gzip" ? "(dict-zstd at 2 K)" : ""}</span></span>
          </li>
        ))}
      </ul>

      <footer class="bench-card__foot">
        At 2&nbsp;K tokens the JSON-SSE stream ships <strong>485&nbsp;KB</strong>;
        Codec msgpack with dict-zstd ships <strong>354&nbsp;bytes</strong>.
        That's <strong>237&nbsp;B/token &rarr; 0.17&nbsp;B/token</strong>.
        Wall-clock overhead is &lt;&nbsp;1% &mdash; the wire reduction is
        essentially free in time.
      </footer>
    </article>

    <!-- ============== CHART 2: cross-stack reduction ============== -->
    <article class="bench-card">
      <header class="bench-card__head">
        <div>
          <h3 class="bench-card__title">Same Codec, three engines</h3>
          <p class="bench-card__sub">2,048-token reply &middot; best-available Codec wire vs JSON-SSE baseline</p>
        </div>
        <div class="bench-card__hero">
          <span class="bench-card__hero-num">3</span>
          <span class="bench-card__hero-cap">engines, one wire format</span>
        </div>
      </header>

      <div class="bench-engines">
        {engineRows.map((e) => {
          const codecKB = e.bestBytes / 1024;
          const codecPct = (codecKB / 540) * 100; // share-of-baseline scale
          return (
            <div class="engine-row">
              <div class="engine-row__name">{e.name}</div>
              <div class="engine-row__bars">
                <div class="engine-bar engine-bar--json" style={`--w:${(e.jsonKB / 540) * 100}%`}>
                  <span class="engine-bar__label">JSON-SSE</span>
                  <span class="engine-bar__value">{e.jsonKB} KB</span>
                </div>
                <div class="engine-codec-row">
                  <div
                    class="engine-bar engine-bar--codec"
                    style={`--w:max(0.4%, ${codecPct}%)`}
                    aria-hidden="true"
                  ></div>
                  <span class="engine-codec-label">
                    <span class="engine-codec-kind">{e.bestKind}</span>
                    <span class="engine-codec-value">{e.bestDisplay}</span>
                  </span>
                </div>
              </div>
              <div class="engine-row__ratio">
                <span class="engine-row__ratio-num">{e.ratio}</span>
                <span class="engine-row__ratio-ttft">@ {e.ttftMs}</span>
              </div>
            </div>
          );
        })}
      </div>

      <footer class="bench-card__foot">
        sglang reaches <strong>1,404&times;</strong> because it has the full
        compression stack (gzip + brotli + dict-zstd) wired into the Codec
        chunker. vllm hits <strong>126&times;</strong> with gzip alone &mdash;
        the dict-loader hook to engage zstd is in flight on the
        <code>wdunn001/vllm</code> fork. llama.cpp's HTTP layer ships gzip
        only; <strong>33&times;</strong> at zero protocol cost.
      </footer>
    </article>

    <!-- ============== CHART 3: TTFB ============== -->
    <article class="bench-card">
      <header class="bench-card__head">
        <div>
          <h3 class="bench-card__title">Time-to-first-byte at 2&nbsp;K tokens</h3>
          <p class="bench-card__sub">Codec msgpack + gzip &middot; median across reps &middot; first body byte (Python httpx)</p>
        </div>
        <div class="bench-card__hero">
          <span class="bench-card__hero-num">~&thinsp;40&thinsp;ms</span>
          <span class="bench-card__hero-cap">on local-network sglang &amp; llama.cpp</span>
        </div>
      </header>

      <div class="bench-chart">
        <svg viewBox="0 0 720 270" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Bar chart: time-to-first-byte at 2,048 tokens. llama.cpp 40.7 milliseconds, sglang 45.6 milliseconds, vllm 67.3 milliseconds. All three engines streaming Codec msgpack with gzip.">
          {ttfbBars.map((b, i) => {
            const y = 30 + i * 70;
            const w = Math.max(2, (b.ms / ttfbMaxMs) * ttfbPlotW);
            return (
              <g class={b.klass}>
                <text x={ttfbPlotX0 - 12} y={y + 28} text-anchor="end" class="bar-label">{b.engine}</text>
                <rect x={ttfbPlotX0} y={y} width={w} height="40" rx="3" />
                <text x={ttfbPlotX0 + w + 12} y={y + 28} class="bar-value">{b.ms} ms</text>
              </g>
            );
          })}
        </svg>
      </div>

      <footer class="bench-card__foot">
        Codec doesn't trade latency for size. <strong>llama.cpp 40.7&nbsp;ms</strong>,
        <strong>sglang 45.6&nbsp;ms</strong>, and <strong>vllm 67.3&nbsp;ms</strong>
        from POST to first body byte at 2&nbsp;K tokens &mdash; the JSON-SSE
        baseline against the same engines is within 1&nbsp;ms either way. The
        decode-side payoff (no UTF-8 reparse, no JSON.parse on every chunk)
        is pure cost reduction on the client.
      </footer>
    </article>

    <!-- ============== CHART 4: cross-vocab handoff (Llama-3 → Qwen-2) ============== -->
    <article class="bench-card">
      <header class="bench-card__head">
        <div>
          <h3 class="bench-card__title">Cross-vocab handoff &mdash; Llama-3 &rarr; Qwen-2</h3>
          <p class="bench-card__sub">Same source IDs, two wire paths &middot; gzip on both &middot; bridge produces byte-identical Qwen-2 output</p>
        </div>
        <div class="bench-card__hero">
          <span class="bench-card__hero-num">15.1&times;</span>
          <span class="bench-card__hero-cap">smaller wire @ 2&nbsp;K, gzip both paths</span>
        </div>
      </header>

      <div class="bench-chart">
        <svg viewBox="0 0 720 320" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Bar chart: cross-vocab handoff from Llama-3 to Qwen-2 at 64, 512, and 2048 tokens. JSON-SSE wire bytes are 585, 2923, and 10683; Codec msgpack wire bytes are 215, 672, and 709. Codec is 2.7x, 4.3x, and 15.1x smaller respectively.">
          {xvocRows.map((r, i) => {
            const yGroup = 30 + i * 90;
            const codecW = Math.max(2, (r.codecBytes / xvocMaxBytes) * xvocPlotW);
            const jsonW  = Math.max(2, (r.jsonBytes  / xvocMaxBytes) * xvocPlotW);
            return (
              <g class="xvoc-group">
                {/* size label on the left */}
                <text x={xvocPlotX0 - 14} y={yGroup + 32} text-anchor="end" class="bar-label">
                  <tspan x={xvocPlotX0 - 14} dy="-0.6em">{r.size}</tspan>
                  <tspan x={xvocPlotX0 - 14} dy="1.2em">tokens</tspan>
                </text>

                {/* JSON-SSE bar (top) */}
                <g class="xvoc-bar xvoc-bar--json">
                  <rect x={xvocPlotX0} y={yGroup} width={jsonW} height="26" rx="3" />
                  <text x={xvocPlotX0 + 8} y={yGroup + 17} class="xvoc-inline-label">JSON-SSE</text>
                  <text x={xvocPlotX0 + jsonW + 10} y={yGroup + 17} class="bar-value">{fmtBytes(r.jsonBytes)}</text>
                </g>

                {/* Codec msgpack bar (bottom) */}
                <g class="xvoc-bar xvoc-bar--codec">
                  <rect x={xvocPlotX0} y={yGroup + 32} width={codecW} height="26" rx="3" />
                  <text x={xvocPlotX0 + 8} y={yGroup + 49} class="xvoc-inline-label">Codec msgpack</text>
                  <text x={xvocPlotX0 + codecW + 10} y={yGroup + 49} class="bar-value">{fmtBytes(r.codecBytes)}</text>
                </g>

                {/* ratio on the right */}
                <text x={690} y={yGroup + 35} text-anchor="end" class="xvoc-ratio">{r.ratio}</text>
              </g>
            );
          })}
        </svg>
      </div>

      <footer class="bench-card__foot">
        The bridge takes Llama-3 IDs over the wire, runs the in-process
        <code>Translator(Llama&nbsp;3&nbsp;&rarr;&nbsp;Qwen&nbsp;2)</code>, and
        hands Qwen-2 IDs to the next agent. UTF-8 never crosses the wire.
        At 2&nbsp;K tokens that's <strong>10.7&nbsp;KB &rarr; 709&nbsp;B</strong>
        on the wire and <strong>10.9&nbsp;ms &rarr; 7.6&nbsp;ms</strong> of
        bridge CPU &mdash; <strong>~30%</strong> less work to translate
        because the bridge skips JSON-SSE parse and re-tokenize-from-scratch.
        Both paths emit the same Qwen-2 token stream byte-for-byte; the
        bench asserts strict equality before reporting numbers.
      </footer>
    </article>

    <!-- ============== CHART 5: tool-call detection ============== -->
    <article class="bench-card bench-card--solo">
      <header class="bench-card__head">
        <div>
          <h3 class="bench-card__title">Tool-call detection on a 1&nbsp;M-token stream</h3>
          <p class="bench-card__sub">Time to detect that a token range is a tool-call region &middot; lower is better</p>
        </div>
        <div class="bench-card__hero">
          <span class="bench-card__hero-num">100&times;</span>
          <span class="bench-card__hero-cap">faster, no detokenize</span>
        </div>
      </header>

      <div class="bench-chart">
        <svg viewBox="0 0 720 220" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Bar chart: tool-call detection on a 1 million token stream. Detokenize plus regex takes 60.4 milliseconds; Codec ToolWatcher takes 0.61 milliseconds.">
          {toolBars.map((b, i) => {
            const y = 30 + i * 90;
            const w = Math.max(2, (b.ms / toolMaxMs) * toolPlotW);
            // Vertically center the label stack on the bar (bar height
            // 50, anchor y+32). For 2-line labels the first tspan lifts
            // up by 0.6em and the second drops 1.2em below it, so the
            // pair straddles the bar center.
            const isMultiline = b.lines.length > 1;
            const labelX = toolPlotX0 - 12;
            return (
              <g class={b.klass}>
                {isMultiline ? (
                  <text x={labelX} y={y + 32} text-anchor="end" class="bar-label">
                    <tspan x={labelX} dy="-0.6em">{b.lines[0]}</tspan>
                    <tspan x={labelX} dy="1.2em">{b.lines[1]}</tspan>
                  </text>
                ) : (
                  <text x={labelX} y={y + 32} text-anchor="end" class="bar-label">{b.lines[0]}</text>
                )}
                <rect x={toolPlotX0} y={y} width={w} height="50" rx="3" />
                <text x={toolPlotX0 + w + 12} y={y + 32} class="bar-value">{b.ms} ms</text>
              </g>
            );
          })}
        </svg>
      </div>

      <footer class="bench-card__foot">
        ToolWatcher matches reserved control IDs in the token stream with a
        single 32-bit compare per token. The text path has to detokenize back
        to UTF-8 first &mdash; the same work the model just did in reverse,
        every chunk. Same advantage shows up in agent loops: a sub-millisecond
        in-band signal beats a multi-millisecond out-of-band parse on every
        single tool boundary.
      </footer>
    </article>

    <p class="bench-source">
      Source: <a href="https://github.com/wdunn001/Codec/blob/main/packages/bench/results/2026-05-08T01-15-02Z/MATRIX.md" rel="noopener">cross-stack MATRIX.md</a>
      &middot; sglang nightly, vllm nightly + <a href="https://github.com/vllm-project/vllm/pull/41765" rel="noopener">PR #41765</a>, llama.cpp + <a href="https://github.com/ggml-org/llama.cpp/pull/22757" rel="noopener">PR #22757</a>
      &middot; Qwen-2.5 0.5B &middot; RTX&nbsp;3090 &middot; temp 0.0
      &middot; reproducible from <code>packages/bench/scripts/run-all-langs.sh</code>.
    </p>
  </div>
</section>

<style>
  .bench__title-mute { color: var(--fg-faint); font-weight: 500; }
  .bench__lede { max-width: 64ch; margin-bottom: 2.5rem; }
  .bench__lede code {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    padding: 0.05rem 0.35rem;
    border-radius: 4px;
    font-size: 0.85em;
    color: var(--fg);
  }
  .bench__lede a { color: var(--data); border-bottom: 1px dotted var(--border-strong); }
  .bench__lede a:hover { border-bottom-color: var(--data); }

  .bench-card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem clamp(1rem, 3vw, 2rem) 1.25rem;
    margin-bottom: 1.5rem;
  }
  .bench-card--solo { margin-bottom: 0; }

  .bench-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .bench-card__title {
    margin: 0 0 0.25rem;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .bench-card__sub {
    margin: 0;
    color: var(--fg-faint);
    font-size: 0.8125rem;
    font-family: var(--font-mono);
  }

  .bench-card__hero {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    line-height: 1.05;
  }
  .bench-card__hero-num {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--data);
    letter-spacing: -0.03em;
  }
  .bench-card__hero-cap {
    margin-top: 0.25rem;
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .bench-chart {
    margin: 0 -0.5rem;
    overflow: hidden;
  }
  .bench-chart svg { display: block; width: 100%; height: auto; }

  /* Chart 1 */
  .grid line { stroke: var(--border); stroke-dasharray: 2 5; }
  .axis-label {
    fill: var(--fg-faint);
