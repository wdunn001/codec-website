    <!-- ============== CHART 6: cost translation ============== -->
    <article class="bench-card bench-card--cost">
      <header class="bench-card__head">
        <div>
          <h3 class="bench-card__title">What the bench numbers cost &mdash; in dollars and watts</h3>
