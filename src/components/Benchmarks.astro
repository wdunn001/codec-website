---
// Benchmarks section: real measurements from the live cross-stack matrix.
// Source: github.com/wdunn001/Codec/blob/main/packages/bench/results/2026-05-15T20-00-00Z/MATRIX.md
//
// All numbers are measured this session — no projections, no theoreticals.
// Hardware: NVIDIA RTX 3090 / Qwen2.5-0.5B-Instruct.
// Engines: sglang nightly, vllm nightly (PR #41765), llama.cpp PR #22757.
// Six client languages (C, .NET, Java, Python, Rust, TS/Node) report
// byte-identical Codec frames on every cell across all three engines
// (24/24 unanimous per engine — see MATRIX.md §2). v0.4 refresh kept
// the same payload shape as v0.3.x, so the wire numbers are unchanged
// from the prior cut — v0.4 is wire-additive (safety-policy negotiation
// + per-language tokenize/detok timing) and doesn't alter the
// in-frame bytes the wire bench measures.

// ============== CHART 1: streaming wire bytes (sglang, the headline) ==
type Series = {
  label: string;
  className: string;
  values: { x: number; bytes: number; display: string }[];
};

// All numbers below are from MATRIX.md §3 (Python row, sglang). Other
// 5 client languages (TS/.NET/C/Rust/Java) agree byte-identically on
// every Codec cell — see the cross-stack panel further down.
//
// X coordinates: data points at 90 / 380 / 600 (was 680). The shift
// inward gives ~110 px of right margin for the end-of-line value
// labels — earlier "485.2 KB" overflowed the 720-unit viewBox.
const series: Series[] = [
  {
    label: "JSON-SSE",
    className: "line line--json",
    values: [
      { x: 90,  bytes: 15200,  display: "15.2 KB" },
      { x: 380, bytes: 121600, display: "121.6 KB" },
      { x: 600, bytes: 485200, display: "485.2 KB" },
    ],
  },
  {
    label: "Codec (identity)",
    className: "line line--codec-id",
    values: [
      { x: 90,  bytes: 975,   display: "975 B" },
      { x: 380, bytes: 7616,  display: "7.6 KB" },
      { x: 600, bytes: 30000, display: "30.0 KB" },
    ],
  },
  {
    label: "Codec + dict-zstd",
    className: "line line--codec-gz",
    values: [
      { x: 90,  bytes: 213,  display: "213 B" },
      { x: 380, bytes: 781,  display: "781 B" },
      { x: 600, bytes: 291,  display: "291 B" },
    ],
  },
];

// TTFB at 2 K tokens for the same sglang server, msgpack + gzip path,
// from MATRIX.md §4 body-byte cohort. Pinned next to the rightmost
// data points so the chart never reads as "smaller wire, hidden
// latency cost" — it's the same ~45 ms either way on sglang.
const ttfbAnnotations = [
  { x: 600, label: "JSON-SSE: ~45 ms TTFB", className: "ttfb-pin ttfb-pin--json" },
  { x: 600, label: "Codec gzip: 44.7 ms TTFB", className: "ttfb-pin ttfb-pin--codec" },
];

// Map a byte count onto the plot's Y coordinate (log10).
// log10(100) = 2 -> y=310 ; log10(1_000_000) = 6 -> y=30 ; 70px per decade.
const yFor = (bytes: number) => {
  const lg = Math.log10(bytes);
  return Math.round((310 - (lg - 2) * 70) * 100) / 100;
};

// Build SVG polyline path for each series.
const linePath = (s: Series) =>
  s.values.map((v) => `${v.x},${yFor(v.bytes)}`).join(" ");

// ============== CHART 2: cross-stack reduction ==
// Three engines, same prompt, same model, same client. Shows that
// Codec is not an sglang trick — it slots into vllm and llama.cpp too.
// Numbers from MATRIX.md §1 headline table (Python row, 2,048 tokens,
// best Codec encoding for each engine).
type EngineRow = {
  name: string;
  jsonKB: number;
  bestBytes: number;
  bestDisplay: string;
  bestKind: string;
  ratio: string;
  // ttftMs is paired with each engine's reduction so the chart never reads
  // as "tiny payload, but at what latency cost?" — it's the same Codec
  // msgpack + gzip first-body-byte median used in chart 3 below.
  ttftMs: string;
};
const engineRows: EngineRow[] = [
  {
    name: "sglang",
    jsonKB: 485,
    bestBytes: 291,
    bestDisplay: "291 B",
    bestKind: "Codec msgpack + dict-zstd",
    ratio: "1,707×",
    ttftMs: "44.7 ms",
  },
  {
    name: "vllm",
    jsonKB: 518,
    bestBytes: 3874,
    bestDisplay: "3.9 KB",
    bestKind: "Codec msgpack + gzip",
    ratio: "137×",
    ttftMs: "59.0 ms",
  },
  {
    name: "llama.cpp",
    jsonKB: 529,
    bestBytes: 140,
    bestDisplay: "140 B",
    bestKind: "Codec msgpack + dict-zstd",
    ratio: "3,868×",
    ttftMs: "40.8 ms",
  },
];

// ============== CHART 3: TTFB ==
// Median first-body-byte latency at 2 K tokens, msgpack + gzip path,
// from MATRIX.md §4 body-byte cohort (Python httpx aiter_raw definition).
//
// Plot layout coordinates (shared with chart 4 below): label column
// 0–128, bar column 140–520, value column 532+. SVG viewBox is 720
// wide so a "60.4 ms" right-edge value fits comfortably without
// overflowing.
const ttfbBars = [
  { engine: "llama.cpp", ms: 40.8, klass: "ttfb-bar ttfb-bar--llama" },
  { engine: "sglang",    ms: 44.7, klass: "ttfb-bar ttfb-bar--sglang" },
  { engine: "vllm",      ms: 59.0, klass: "ttfb-bar ttfb-bar--vllm" },
];
const ttfbMaxMs = 80;
const ttfbPlotX0 = 140;
const ttfbPlotW  = 380;

// ============== CHART 4: cross-vocab handoff ==
//
// Numbers from packages/bench/results/2026-05-08T01-15-02Z/translator/python.json
// Two paths timed against the SAME source ID stream (Llama-3 IDs):
//   - Codec wire:   IDs cross the wire, bridge runs Translator(Llama->Qwen)
//                   in-process (detok + retok stays in-memory)
//   - JSON-SSE:     A.detokenize -> SSE chunks cross the wire,
//                   bridge parses SSE + BPE-encodes for Qwen
// Both paths produce identical Qwen-2 IDs (asserted by the bench).
type XvocRow = {
  size: number;
  codecBytes: number;
  jsonBytes: number;
  ratio: string;
  codecCpuMs: number;
  jsonCpuMs: number;
};
const xvocRows: XvocRow[] = [
  // codecCpuMs/jsonCpuMs pulled with one extra decimal so the
  // computed savings rounds to the same number quoted in the footer
  // and overview.md (29.6 % -> 30 %, not 7.7/10.9 -> 29 %).
  { size: 64,   codecBytes:  215, jsonBytes:    585, ratio: "2.7×",  codecCpuMs: 1.16, jsonCpuMs: 1.21 },
  { size: 512,  codecBytes:  672, jsonBytes:   2923, ratio: "4.3×",  codecCpuMs: 3.88, jsonCpuMs: 4.79 },
  { size: 2048, codecBytes:  709, jsonBytes:  10683, ratio: "15.1×", codecCpuMs: 7.67, jsonCpuMs: 10.90 },
];
// Format helpers
const fmtBytes = (n: number) => n < 1024 ? `${n} B` : `${(n / 1024).toFixed(1)} KB`;
const xvocMaxBytes = 11000;
const xvocPlotX0 = 90;
const xvocPlotW  = 380;

// ============== CHART 5: tool-call detection ==
//
// `lines` is an array of label rows so wide labels wrap into multiple
// tspans within a single SVG <text> — SVG doesn't auto-wrap and a
// long label like "Detokenize + regex" overflowed the 128-unit label
// column on its own line.
// v0.4.1 lab measurement on AMD EPYC 8124P + gcc:13 (libcodec C99).
// Per-1M-token stream with 5% region density:
//   - codec_tool_watcher_feed:  2.08 ns/token → 1M tokens in 2.08 ms (481 Mtok/s)
//   - codec_detokenizer_render: 55.42 ns/token → 1M tokens in 55.42 ms (18 Mtok/s)
//   Speedup: 26.7×. Prior "~100×" headline was from an undocumented
//   CPU/compiler combination; the speedup-ratio remains in ToolWatcher's
//   favour by ~26-100× depending on the host.
const toolMaxMs = 60;
const toolPlotX0 = 140;
const toolPlotW  = 380;
const toolBars = [
  { lines: ["Detokenize", "+ regex"], ms: 55.42, klass: "tool-bar tool-bar--text" },
  { lines: ["Codec ToolWatcher"],     ms: 2.08,  klass: "tool-bar tool-bar--codec" },
];
---

<section id="benchmarks" class="section bench">
  <div class="container">
    <p class="eyebrow">receipts</p>
    <h2>What falls out when the inference layer stays token-native.</h2>
    <p class="bench__lede">
      Compression isn't the headline &mdash; the primitives are. But once
      every hop runs on raw <code>uint32</code> token IDs, the wire reduction
      and the tool-call latency floor are measurable byproducts. Numbers
      below are from the cross-stack benchmark matrix: same prompt, same
      model, three real inference engines, six real client languages. Every
      cell is measured. Full SCHEMA-v1 result JSONs in
      <a href="https://github.com/wdunn001/Codec/tree/main/packages/bench/results" rel="noopener"><code>packages/bench/results/</code></a>.
    </p>

    <!-- ============== LAB CARD: all three v0.3 pathways, re-validated for v0.4 ============== -->
    <article class="bench-card bench-card--v03">
      <header class="bench-card__head">
        <div>
          <h3 class="bench-card__title">Lab run &mdash; all three pathways measured</h3>
          <p class="bench-card__sub">vinez@192.168.1.88 &middot; 2&times; RTX 3090 &middot; v0.4.1 cut, 2026-05-15 (wire numbers unchanged from v0.3.x &mdash; v0.4.x is wire-additive; v0.4.1 ships dict-zstd across all 6 clients + br&nbsp;+&nbsp;zstd on llama.cpp)</p>
        </div>
        <div class="bench-card__hero">
          <span class="bench-card__hero-num">3.9&times;</span>
          <span class="bench-card__hero-cap">int4 latent vs raw</span>
        </div>
      </header>

      <div class="v03-grid">
        <div class="v03-cell v03-cell--mcp">
          <div class="v03-cell__tag">MCP gateway</div>
          <div class="v03-cell__title">tools/list across 40 tools</div>
          <table class="v03-table">
            <thead><tr><th></th><th>wire</th><th>vs JSON</th></tr></thead>
            <tbody>
              <tr><td>JSON-RPC</td><td>21.4 KB</td><td>1.0&times;</td></tr>
              <tr class="v03-row--win"><td>msgpack&nbsp;+&nbsp;gzip</td><td>5.9 KB</td><td><strong>3.6&times;</strong></td></tr>
            </tbody>
          </table>
          <p class="v03-cell__foot">
            <code>[Codec][leaf]</code> log fires end-to-end on
            <a href="https://hub.docker.com/r/wdunn001/codec-time-leaf" rel="noopener">codec-time-leaf</a>
            tool calls &mdash; gateway becomes a transparent ID pipe.
          </p>
        </div>

        <div class="v03-cell v03-cell--latent">
          <div class="v03-cell__tag">Latents (v0.3)</div>
          <div class="v03-cell__title">512&times;512 SD-1.5 latent on the wire</div>
          <table class="v03-table">
            <thead><tr><th>pipeline</th><th>wire</th><th>vs raw</th></tr></thead>
            <tbody>
              <tr><td>raw fp16</td><td>32.4 KB</td><td>1.0&times;</td></tr>
              <tr><td>int8</td><td>16.4 KB</td><td>2.0&times;</td></tr>
              <tr class="v03-row--win"><td>int4</td><td>8.4 KB</td><td><strong>3.9&times;</strong></td></tr>
            </tbody>
          </table>
          <p class="v03-cell__foot">
            For comparison: same image as a JPEG ~80&ndash;150&nbsp;KB; raw fp16 pixels 1.5&nbsp;MB.
            int4 = <strong>~10&times; smaller than JPEG</strong>, ~180&times; vs raw pixels.
          </p>
        </div>
      </div>

      <footer class="bench-card__foot">
        Numbers from <a href="https://github.com/wdunn001/Codec/tree/main/packages/bench/results/2026-05-09T12-17-48Z/mcp" rel="noopener">2026-05-09T12-17-48Z (mcp)</a>
        and <a href="https://github.com/wdunn001/Codec/tree/main/packages/bench/results/2026-05-09T13-01-55Z/latent" rel="noopener">2026-05-09T13-01-55Z (latent)</a>,
        re-validated in the
        <a href="https://github.com/wdunn001/Codec/tree/main/packages/bench/results/2026-05-15T20-00-00Z" rel="noopener">2026-05-15T20-00-00Z</a>
        v0.4.1 cross-stack run (24/24 wire&nbsp;+ 24/24 decode unanimous on every engine).
        Pipeline math validates byte-for-byte against
        <a href="https://github.com/wdunn001/Codec/blob/main/spec/PIPELINES.md" rel="noopener">spec/PIPELINES.md</a>;
        the leaf-mode bypass story is in the
        <a href="/changelog/">What's new</a> feed (v0.4 entry).
      </footer>
    </article>

    <!-- ============== CHART 1: streaming wire bytes ============== -->
    <article class="bench-card">
      <header class="bench-card__head">
        <div>
          <h3 class="bench-card__title">Streaming wire bytes by payload size</h3>
          <p class="bench-card__sub">sglang &middot; lower is better &middot; Y axis is log scale (each gridline is 10&times;)</p>
        </div>
        <div class="bench-card__hero">
          <span class="bench-card__hero-num">1,707&times;</span>
          <span class="bench-card__hero-cap">smaller at 2,048 tokens</span>
        </div>
      </header>

      <div class="bench-chart">
        <svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Line chart: streaming wire bytes by payload size on sglang. JSON-SSE grows from 15.2 KB at 64 tokens to 485.2 KB at 2,048 tokens. Codec with dict-zstd lands at 213 bytes, 781 bytes, and 291 bytes for the same three sizes.">
          <!-- Y gridlines + labels -->
          {[
            { y: 30,  label: "1 MB" },
            { y: 100, label: "100 KB" },
            { y: 170, label: "10 KB" },
            { y: 240, label: "1 KB" },
            { y: 310, label: "100 B" },
          ].map((g) => (
            <g class="grid">
              <line x1="80" x2="610" y1={g.y} y2={g.y} />
              <text x="72" y={g.y + 4} text-anchor="end" class="axis-label">{g.label}</text>
            </g>
          ))}

          <!-- X axis labels -->
          {[
            { x: 90,  label: "64 tokens" },
            { x: 380, label: "512 tokens" },
            { x: 600, label: "2,048 tokens" },
          ].map((t) => (
            <text x={t.x} y={335} text-anchor="middle" class="axis-label">{t.label}</text>
          ))}

          <!-- Series lines + dots + end-labels -->
          {series.map((s) => (
            <g class={s.className}>
              <polyline points={linePath(s)} fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              {s.values.map((v) => (
                <circle cx={v.x} cy={yFor(v.bytes)} r="4" />
              ))}
              <text x={s.values[s.values.length - 1].x + 10} y={yFor(s.values[s.values.length - 1].bytes) + 4} class="line-end-label">{s.values[s.values.length - 1].display}</text>
            </g>
          ))}

          <!-- TTFB pin block: same TTFB on both wire paths, so the
               chart never reads as "smaller wire, hidden latency
               cost". Bytes shrink 1,707x; first-body-byte stays the
               same. Placed in the empty band between the Codec
               (identity) and Codec (+ dict-zstd) lines so it can't
               collide with the JSON-SSE label at y~52 or the Codec
               id label at y~141. -->
          <g class="ttfb-pin-block">
            <rect x="425" y="180" width="265" height="64" rx="6" class="ttfb-pin-bg" />
            <text x="437" y="200" class="ttfb-pin-head">TTFB @ 2 K tokens · sglang · same wire</text>
            <text x="437" y="219" class="ttfb-pin-line">
              <tspan class="ttfb-pin-key">JSON-SSE</tspan>
              <tspan class="ttfb-pin-val" dx="8">~45 ms</tspan>
              <tspan class="ttfb-pin-key" dx="14">Codec + gzip</tspan>
              <tspan class="ttfb-pin-val ttfb-pin-val--codec" dx="8">44.7 ms</tspan>
            </text>
            <text x="437" y="236" class="ttfb-pin-foot">first-body-byte median, body-byte cohort</text>
          </g>
        </svg>
      </div>

      <ul class="bench-legend">
        {series.map((s) => (
          <li class={s.className.replaceAll("line", "swatch")}>
            <span class="swatch__line" aria-hidden="true"></span>
            <span class="swatch__label">{s.label}</span>
          </li>
        ))}
      </ul>

      <footer class="bench-card__foot">
        At 2&nbsp;K tokens the JSON-SSE stream ships <strong>485&nbsp;KB</strong>;
        Codec msgpack with dict-zstd ships <strong>291&nbsp;bytes</strong>.
        That's <strong>237&nbsp;B/token &rarr; 0.14&nbsp;B/token</strong>
        at the <strong>same TTFB</strong> &mdash; first-body-byte lands
        at ~45&nbsp;ms either way on the same sglang server. The wire
        reduction is essentially free in latency.
      </footer>
    </article>

    <!-- ============== CHART 2: cross-stack reduction ============== -->
    <article class="bench-card">
      <header class="bench-card__head">
        <div>
          <h3 class="bench-card__title">Same Codec, three engines</h3>
          <p class="bench-card__sub">2,048-token reply &middot; best-available Codec wire vs JSON-SSE baseline</p>
        </div>
        <div class="bench-card__hero">
          <span class="bench-card__hero-num">3</span>
          <span class="bench-card__hero-cap">engines, one wire format</span>
        </div>
      </header>

      <div class="bench-engines">
        {engineRows.map((e) => {
          const codecKB = e.bestBytes / 1024;
          const codecPct = (codecKB / 540) * 100; // share-of-baseline scale
          return (
            <div class="engine-row">
              <div class="engine-row__name">{e.name}</div>
              <div class="engine-row__bars">
                <div class="engine-bar engine-bar--json" style={`--w:${(e.jsonKB / 540) * 100}%`}>
                  <span class="engine-bar__label">JSON-SSE</span>
                  <span class="engine-bar__value">{e.jsonKB} KB</span>
                </div>
                <div class="engine-codec-row">
                  <div
                    class="engine-bar engine-bar--codec"
                    style={`--w:max(0.4%, ${codecPct}%)`}
                    aria-hidden="true"
                  ></div>
                  <span class="engine-codec-label">
                    <span class="engine-codec-kind">{e.bestKind}</span>
                    <span class="engine-codec-value">{e.bestDisplay}</span>
                  </span>
                </div>
              </div>
              <div class="engine-row__ratio">
                <span class="engine-row__ratio-num">{e.ratio}</span>
                <span class="engine-row__ratio-ttft">@ {e.ttftMs}</span>
              </div>
            </div>
          );
        })}
      </div>

      <footer class="bench-card__foot">
        sglang reaches <strong>1,707&times;</strong> on msgpack&nbsp;+&nbsp;dict-zstd because it has the full
        compression stack (gzip + brotli + dict-zstd) wired into the Codec
        chunker. llama.cpp added brotli + zstd in v0.4.1 and now hits
        <strong>3,868&times;</strong> on dict-zstd as well. vllm hits
        <strong>137&times;</strong> with gzip; its content compresses less
        cooperatively at temperature&nbsp;=&nbsp;0, so the ratio is content-bound,
        not protocol-bound (see the synthetic-stream cells for the protocol-
        only headline).
      </footer>
    </article>

    <!-- ============== CHART 3: TTFB ============== -->
    <article class="bench-card">
      <header class="bench-card__head">
        <div>
          <h3 class="bench-card__title">Time-to-first-byte at 2&nbsp;K tokens</h3>
          <p class="bench-card__sub">Codec msgpack + gzip &middot; median across reps &middot; first body byte (Python httpx)</p>
        </div>
        <div class="bench-card__hero">
          <span class="bench-card__hero-num">~&thinsp;40&thinsp;ms</span>
          <span class="bench-card__hero-cap">on local-network sglang &amp; llama.cpp</span>
        </div>
      </header>

      <div class="bench-chart">
        <svg viewBox="0 0 720 270" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Bar chart: time-to-first-byte at 2,048 tokens. llama.cpp 40.7 milliseconds, sglang 45.6 milliseconds, vllm 67.3 milliseconds. All three engines streaming Codec msgpack with gzip.">
          {ttfbBars.map((b, i) => {
            const y = 30 + i * 70;
            const w = Math.max(2, (b.ms / ttfbMaxMs) * ttfbPlotW);
            return (
              <g class={b.klass}>
                <text x={ttfbPlotX0 - 12} y={y + 28} text-anchor="end" class="bar-label">{b.engine}</text>
                <rect x={ttfbPlotX0} y={y} width={w} height="40" rx="3" />
                <text x={ttfbPlotX0 + w + 12} y={y + 28} class="bar-value">{b.ms} ms</text>
              </g>
            );
          })}
        </svg>
      </div>

      <footer class="bench-card__foot">
        Codec doesn't trade latency for size. <strong>llama.cpp 40.7&nbsp;ms</strong>,
        <strong>sglang 45.6&nbsp;ms</strong>, and <strong>vllm 67.3&nbsp;ms</strong>
        from POST to first body byte at 2&nbsp;K tokens &mdash; the JSON-SSE
        baseline against the same engines is within 1&nbsp;ms either way. The
        decode-side payoff (no UTF-8 reparse, no JSON.parse on every chunk)
        is pure cost reduction on the client.
      </footer>
    </article>

    <!-- ============== CHART 4: cross-vocab handoff (Llama-3 → Qwen-2) ============== -->
    <article class="bench-card">
      <header class="bench-card__head">
        <div>
          <h3 class="bench-card__title">Cross-vocab handoff &mdash; Llama-3 &rarr; Qwen-2</h3>
          <p class="bench-card__sub">Same source IDs, two wire paths &middot; gzip on both &middot; bridge produces byte-identical Qwen-2 output</p>
        </div>
        <div class="bench-card__hero bench-card__hero--dual">
          <span class="bench-card__hero-num">30%</span>
          <span class="bench-card__hero-cap">faster bridge response @ 2&nbsp;K</span>
          <span class="bench-card__hero-sep">·</span>
          <span class="bench-card__hero-num bench-card__hero-num--alt">15.1&times;</span>
          <span class="bench-card__hero-cap">smaller wire @ 2&nbsp;K</span>
        </div>
      </header>

      <h4 class="bench-subhead">Bridge response time &mdash; the latency the next agent waits on</h4>
      <p class="bench-subhead-note">CPU cost to turn the inbound stream into Qwen-2 IDs ready for agent B. Lower is better &mdash; this is the wall-clock the handoff blocks on, before agent B's first new token.</p>

      <div class="bench-chart">
        <svg viewBox="0 0 720 270" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Bar chart: bridge CPU at 64, 512, and 2048 tokens. JSON-SSE 1.2, 4.8, 10.9 ms; Codec msgpack 1.2, 3.9, 7.6 ms.">
          {xvocRows.map((r, i) => {
            const yGroup = 30 + i * 75;
            // Linear ms scale; max ~12 ms gives headroom past the 10.9 ms top.
            const xvocMaxMs = 12;
            const xvocCpuPlotX0 = 90;
            const xvocCpuPlotW  = 380;
            const codecW = Math.max(2, (r.codecCpuMs / xvocMaxMs) * xvocCpuPlotW);
            const jsonW  = Math.max(2, (r.jsonCpuMs  / xvocMaxMs) * xvocCpuPlotW);
            const cpuRatio = r.jsonCpuMs > 0 ? Math.round((1 - r.codecCpuMs / r.jsonCpuMs) * 100) : 0;
            // Astro's JSX-in-expression parser treats `<=` as the start
            // of a fragment tag, so invert: ratio > 5 means a savings
            // visible above the rep-to-rep noise on a microbench at
            // this CPU duration. Below that, both paths read "tied" —
            // matches what you'd see in a profiler trace.
            const cpuRatioStr = cpuRatio > 5 ? `−${cpuRatio}%` : "tied";
            return (
              <g class="xvoc-group">
                <text x={xvocCpuPlotX0 - 14} y={yGroup + 32} text-anchor="end" class="bar-label">
                  <tspan x={xvocCpuPlotX0 - 14} dy="-0.6em">{r.size}</tspan>
                  <tspan x={xvocCpuPlotX0 - 14} dy="1.2em">tokens</tspan>
                </text>
                <g class="xvoc-bar xvoc-bar--json">
                  <rect x={xvocCpuPlotX0} y={yGroup} width={jsonW} height="26" rx="3" />
                  <text x={xvocCpuPlotX0 + 8} y={yGroup + 17} class="xvoc-inline-label">JSON-SSE</text>
                  <text x={xvocCpuPlotX0 + jsonW + 10} y={yGroup + 17} class="bar-value">{r.jsonCpuMs}&thinsp;ms</text>
                </g>
