---
// Hero — proportional byte-collapse figure.
//
// Top row: 142 small grey cells representing JSON wire bytes (one per char).
// Funnel: a subtle wedge that visually narrows from JSON-row width down to
//         Codec-row width.
// Bottom row: 32 same-sized cells (8 token groups of 4), but rendered in
//             the *same scale* as the top — so the contrast in TOTAL WIDTH
//             reads at a glance as "4× shorter".
// Compression sweep: a thin horizontal line travels top→bottom through the
//                    funnel every few seconds, suggesting active flow.
//
// Pure SVG + CSS keyframes. Zero JS.

// JSON row geometry. Both rows are HORIZONTALLY CENTERED in the viewBox
// (1080 wide) so the figure reads as balanced rather than right-leaning
// at the top.
const jsonByteW = 6;
const jsonByteCount = 142;
const jsonByteH = 18;
const jsonRowY = 80;
const jsonRowHeight = jsonByteH;
const jsonRowWidth = jsonByteCount * jsonByteW; // 852
const jsonRowX = (1080 - jsonRowWidth) / 2;     // = 114 — centered on viewBox

// Codec row geometry: same per-byte width as JSON so the totals are
// directly comparable. Group of 4 bytes per token, 4px gap between groups.
// Codec row is HORIZONTALLY CENTERED in the viewBox (1080 wide) so the
// figure reads as balanced rather than left-heavy.
const codecByteW = 6;
const codecByteH = 26;
const codecRowY = 200;
const codecTokenCount = 8;
const codecGapBetweenGroups = 4;
const codecGroupWidth = 4 * codecByteW; // 24
const codecRowWidth =
  codecTokenCount * codecGroupWidth + (codecTokenCount - 1) * codecGapBetweenGroups; // 220
const codecRowX = (1080 - codecRowWidth) / 2; // = 430 — centered on viewBox

// Funnel: from full JSON width down to Codec row width
const funnelTopY = 102;
const funnelBottomY = 192;

// Build the JSON byte cells (alternating two greys for visual rhythm)
const jsonBytes = Array.from({ length: jsonByteCount }, (_unused, i) => ({
  x: i * jsonByteW,
  isStruct: i % 13 === 0 || i % 13 === 6, // mimic JSON's structural chars
}));

// Build the Codec byte cells
const codecCells = Array.from({ length: codecTokenCount }, (_unused, t) => {
  const groupX = t * (codecGroupWidth + codecGapBetweenGroups);
  return Array.from({ length: 4 }, (_unused2, b) => ({
    x: groupX + b * codecByteW,
    isCtrl: t === codecTokenCount - 1 && b === 3,
    tokenIndex: t,
    byteIndex: b,
  }));
}).flat();
---
<section class="section section--hero hero">
  <div class="container">
    <p class="eyebrow">
      v0.3 shipping &middot; source-available &middot;
      <a href="/changelog/" style="color: var(--data); text-decoration: none;">what's new &rarr;</a>
    </p>
    <h1 class="hero__title">
      The control plane<br/>
      <span class="hero__title-accent">for AI inference.</span>
    </h1>
    <p class="hero__lede">
      Codec is the substrate that lets gateways, routers, agents, and tool
      dispatchers operate on raw token IDs end-to-end. Detokenize once, at
      the only edge that needs text &mdash; never per-token, never per-hop.
      v0.3 extends the same wire format to <a href="/docs/codec-metamcp/">MCP tool calls</a>
      (with leaf-mode bypass) and <a href="/docs/codec-diffusers/">image / video latents</a>.
      Compression and wire reduction are byproducts; what you actually buy is
      the ability to run the inference layer like infrastructure.
    </p>

    <div class="hero__cta">
      <a href="#use-cases" class="btn btn--primary">What it gives you &rarr;</a>
      <a href="/protocol-map/" class="btn">Protocol map</a>
      <a href="https://github.com/wdunn001/Codec" rel="noopener" class="btn">github / wdunn001/Codec</a>
    </div>

    <figure class="wire" aria-label="Diagram: a 142-byte JSON wire stream collapses through a funnel into a 32-byte Codec stream — about 4× shorter on the wire.">
      <svg viewBox="0 0 1080 270" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
        <defs>
          <!-- Symmetric gentle fade on both sides: bytes ease in on the
               left at the JSON label and ease out on the right at the
               142-bytes label. The masked group contains TWO copies of
               the byte row (for the drift loop), so its objectBoundingBox
               is twice the visible width — pin the gradient + mask to
               userSpaceOnUse so 0–100 % maps to the visible row and the
               right fade actually lands on the visible right edge instead
               of being clipped off the side. -->
          <linearGradient id="fade"
                          gradientUnits="userSpaceOnUse"
                          x1={jsonRowX} y1="0"
                          x2={jsonRowX + jsonRowWidth} y2="0">
            <stop offset="0%"   stop-color="#0A0A0A" stop-opacity="1" />
            <stop offset="11%"  stop-color="#0A0A0A" stop-opacity="0" />
            <stop offset="89%"  stop-color="#0A0A0A" stop-opacity="0" />
            <stop offset="100%" stop-color="#0A0A0A" stop-opacity="1" />
          </linearGradient>
          <mask id="fadeMask" maskUnits="userSpaceOnUse"
                x={jsonRowX} y={jsonRowY - 6}
                width={jsonRowWidth} height={jsonRowHeight + 12}>
            <rect x={jsonRowX} y={jsonRowY - 6} width={jsonRowWidth} height={jsonRowHeight + 12} fill="white" />
            <rect x={jsonRowX} y={jsonRowY - 6} width={jsonRowWidth} height={jsonRowHeight + 12} fill="url(#fade)" />
          </mask>

          <linearGradient id="funnelGrad" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0%"   stop-color="#3B82F6" stop-opacity="0.20" />
            <stop offset="100%" stop-color="#3B82F6" stop-opacity="0.06" />
          </linearGradient>

          <clipPath id="funnelClip">
            <polygon points={`${jsonRowX},${funnelTopY} ${jsonRowX + jsonRowWidth},${funnelTopY} ${codecRowX + codecRowWidth},${funnelBottomY} ${codecRowX},${funnelBottomY}`} />
          </clipPath>

          <!-- Hard clip for the JSON byte row so the drift-loop's second
               copy can't visibly spill past the 142-bytes label. The mask
               above still provides the gentle soft fade INSIDE this clip. -->
          <clipPath id="jsonRowClip">
            <rect x={jsonRowX} y={jsonRowY - 6} width={jsonRowWidth} height={jsonRowHeight + 12} />
          </clipPath>
        </defs>

        <!-- Top row labels -->
        <text x={jsonRowX} y={jsonRowY - 28} class="row-label">JSON</text>
        <text x={jsonRowX} y={jsonRowY - 12} class="row-sub">~ 1 byte / character</text>
        <text x={jsonRowX + jsonRowWidth} y={jsonRowY - 12} text-anchor="end" class="row-count">142 bytes</text>

        <!-- JSON byte stream: clipped hard to row bounds so no spill past
             the labels, with a gentle fade mask alongside the clip for
             soft edges that mirror each other on both sides. Both clip
             and mask sit on the SAME outer group so they see the SVG
             user-space directly — putting the mask on the inner
             translated group would have the mask's userSpaceOnUse
             coordinates clash with the translate. -->
        <g clip-path="url(#jsonRowClip)" mask="url(#fadeMask)">
          <g transform={`translate(${jsonRowX}, ${jsonRowY})`}>
          <g class="json-stream">
            {jsonBytes.map((b) => (
              <rect
                x={b.x}
                y={0}
                width={jsonByteW - 1}
                height={jsonRowHeight}
                rx="1"
                fill={b.isStruct ? "#374151" : "#525B6B"}
              />
            ))}
            {/* Repeat the byte pattern once shifted right so the drift loops cleanly */}
            {jsonBytes.map((b) => (
              <rect
                x={b.x + jsonRowWidth}
                y={0}
                width={jsonByteW - 1}
                height={jsonRowHeight}
                rx="1"
                fill={b.isStruct ? "#374151" : "#525B6B"}
              />
            ))}
          </g>
          </g>
        </g>

        <!-- Funnel + compression sweep -->
        <g class="funnel">
          <polygon
            points={`${jsonRowX},${funnelTopY} ${jsonRowX + jsonRowWidth},${funnelTopY} ${codecRowX + codecRowWidth},${funnelBottomY} ${codecRowX},${funnelBottomY}`}
            fill="url(#funnelGrad)"
            stroke="#2C3E55"
            stroke-width="1"
          />

          <!-- Convergence guide lines -->
          <line x1={jsonRowX + jsonRowWidth * 0.30} y1={funnelTopY} x2={codecRowX + codecRowWidth * 0.30} y2={funnelBottomY} stroke="#2C3E55" stroke-width="0.75" stroke-dasharray="2 4" />
          <line x1={jsonRowX + jsonRowWidth * 0.55} y1={funnelTopY} x2={codecRowX + codecRowWidth * 0.55} y2={funnelBottomY} stroke="#2C3E55" stroke-width="0.75" stroke-dasharray="2 4" />
          <line x1={jsonRowX + jsonRowWidth * 0.80} y1={funnelTopY} x2={codecRowX + codecRowWidth * 0.80} y2={funnelBottomY} stroke="#2C3E55" stroke-width="0.75" stroke-dasharray="2 4" />

          <!-- Compression sweep: a horizontal line that travels top -> bottom inside the clipped funnel -->
          <g clip-path="url(#funnelClip)">
            <rect class="sweep" x={jsonRowX} y={funnelTopY} width={jsonRowWidth} height="2" fill="#3B82F6" />
          </g>

          <!-- "4× shorter" annotation centered on viewBox (matches the funnel bottom centerline) -->
          <text x={1080 / 2} y={funnelTopY + (funnelBottomY - funnelTopY) / 2 + 4} text-anchor="middle" class="funnel-label">4&times; shorter on the wire</text>
        </g>

        <!-- Bottom row labels -->
        <text x={codecRowX} y={codecRowY - 12} class="row-label">CodeC</text>
        <text x={codecRowX} y={codecRowY + codecByteH + 18} class="row-sub">8 token IDs &middot; 4 bytes each (uint32)</text>
        <text x={codecRowX + codecRowWidth + 16} y={codecRowY + codecByteH / 2 + 5} class="row-count row-count--accent">32 bytes</text>

        <!-- Codec byte cells (8 token groups, last byte is control) -->
        <g transform={`translate(${codecRowX}, ${codecRowY})`}>
          {codecCells.map((c, i) => (
            <rect
              class={`codec-cell${c.isCtrl ? " codec-cell--ctrl" : ""}`}
              x={c.x}
              y={0}
              width={codecByteW - 1}
              height={codecByteH}
              rx="2"
              fill={c.isCtrl ? "var(--control)" : "var(--data)"}
              style={`--ti:${i}`}
            />
          ))}
        </g>
      </svg>

      <figcaption class="wire__caption">
        Token IDs straight on the wire. Tool-call dispatch, observability,
        cross-vocab handoff &mdash; all the things you'd want to do at the
        inference layer reduce to integer compares on the stream. Detokenize
        becomes a byproduct, not a per-token cost.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { padding-bottom: clamp(2rem, 6vw, 4rem); }
  .hero__title {
    font-size: clamp(2.5rem, 6.5vw, 4.5rem);
    font-weight: 700;
    margin-bottom: 1.25rem;
    max-width: 18ch;
  }
  .hero__title-accent { color: var(--data); }
  .hero__lede {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--fg-muted);
    max-width: 60ch;
    margin-bottom: 2rem;
  }
  .hero__lede code {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    padding: 0.05rem 0.35rem;
    border-radius: 4px;
    font-size: 0.85em;
    color: var(--fg);
  }
  .hero__cta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-bottom: 3rem;
  }

  .wire {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    background:
      radial-gradient(80% 100% at 0% 0%, color-mix(in srgb, var(--data) 6%, transparent), transparent 60%),
      linear-gradient(180deg, var(--bg-elev) 0%, var(--bg) 100%);
    padding: 1rem 0 1rem;
    overflow: hidden;
  }
  .wire svg { display: block; width: 100%; height: auto; }
  .wire__caption {
    padding: 0 1.5rem 0.25rem;
    color: var(--fg-faint);
    font-size: 0.8125rem;
    max-width: 70ch;
  }

  .row-label {
    fill: var(--fg);
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .row-sub {
    fill: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
  }
  .row-count {
    fill: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }
  .row-count--accent { fill: var(--control); font-weight: 700; }

  .funnel-label {
    fill: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* JSON stream drifts left forever; the second copy of the byte pattern fills back in */
  .json-stream {
    animation: drift 14s linear infinite;
  }
  @keyframes drift {
    from { transform: translateX(0); }
    to   { transform: translateX(-852px); } /* one full pattern width */
  }

  /* Compression sweep: a thin line travels top -> bottom inside the funnel,
     repeating every few seconds. Decorative — does NOT gate cell visibility. */
  .sweep {
    animation: sweep 5s cubic-bezier(0.5, 0, 0.5, 1) infinite;
    opacity: 0;
  }
  @keyframes sweep {
    0%   { transform: translateY(0px);  opacity: 0; }
    10%  { opacity: 0.6; }
    70%  { transform: translateY(90px); opacity: 0.85; }
    78%  { transform: translateY(90px); opacity: 0; }
    100% { transform: translateY(90px); opacity: 0; }
  }

  /* Codec cells: STEADY visible (subtle pulse, never invisible).
     Each cell stays at >=70% opacity at all times, briefly brightens to
     100% in a left-to-right wave triggered every 5s in sync with the sweep. */
  .codec-cell {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0.78;
    animation: cellWave 5s ease-out infinite;
    animation-delay: calc(0.5s + var(--ti) * 0.025s);
  }
  @keyframes cellWave {
    0%, 60%, 100% { opacity: 0.78; transform: translateY(0); }
    68%           { opacity: 1;    transform: translateY(-1.5px); }
    76%           { opacity: 1;    transform: translateY(0); }
  }
  .codec-cell--ctrl {
    /* control byte (green) reads as the punctuation; subtle steady glow */
    filter: drop-shadow(0 0 3px color-mix(in srgb, var(--control) 70%, transparent));
  }
</style>
