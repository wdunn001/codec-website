---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "Codec — Token-native binary transport for AI APIs",
  description = "Codec is a wire format for computer-to-computer AI traffic. Skip JSON, send token IDs as bytes.",
  canonical = Astro.url.href,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="/codec.svg" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__row">
        <a href="/" class="brand" aria-label="CodeC home">
          <span class="brand__bytes" aria-hidden="true">
            <span class="brand__byte brand__byte--data"></span>
            <span class="brand__byte brand__byte--data"></span>
            <span class="brand__byte brand__byte--data"></span>
            <span class="brand__byte brand__byte--ctrl"></span>
          </span>
          <span class="brand__name">CodeC</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="#how">How it works</a>
          <a href="#compare">Compare</a>
          <a href="#benchmarks">Benchmarks</a>
          <a href="https://github.com/wdunn001/Codec" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container site-footer__row">
        <div>
          <span class="brand__name">CodeC</span>
          <span class="site-footer__muted"> &middot; computer to computer</span>
        </div>
        <div class="site-footer__links">
          <a href="https://github.com/wdunn001/Codec" rel="noopener">Codec</a>
          <a href="https://github.com/wdunn001/codec-maps" rel="noopener">codec-maps</a>
          <a href="mailto:licensing@quasarke.com">Licensing</a>
        </div>
        <div class="site-footer__muted">&copy; 2026 Quasarke LLC</div>
      </div>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(12px);
        background: color-mix(in srgb, var(--bg) 80%, transparent);
        border-bottom: 1px solid var(--border);
      }
      .site-header__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.875rem;
        padding-bottom: 0.875rem;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        font-family: var(--font-mono);
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .brand__bytes {
        display: inline-flex;
        gap: 2px;
      }
      .brand__byte {
        width: 8px;
        height: 8px;
        border-radius: 1px;
      }
      .brand__byte--data { background: var(--data); }
      .brand__byte--ctrl { background: var(--control); }
      .brand__name { font-size: 0.95rem; }

      .site-nav {
        display: inline-flex;
        gap: 1.5rem;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--fg-muted);
      }
      .site-nav a:hover { color: var(--fg); }
      @media (max-width: 540px) {
        .site-nav { gap: 1rem; }
        .site-nav a:nth-child(1) { display: none; }
      }

      .site-footer {
        margin-top: auto;
        border-top: 1px solid var(--border);
        padding: 2rem 0;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
      }
      .site-footer__row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
        color: var(--fg-muted);
      }
      .site-footer__links { display: inline-flex; gap: 1.25rem; }
      .site-footer__muted { color: var(--fg-faint); }
    </style>
  </body>
</html>
