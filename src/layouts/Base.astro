---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "Codec — Token-native binary transport for AI APIs",
  description = "Codec is a wire format for computer-to-computer AI traffic. Skip JSON, send token IDs as bytes.",
  canonical = Astro.url.href,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Codec — What's new" href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="/codec.svg" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__row">
        <a href="/" class="brand" aria-label="CodeC home">
          <span class="brand__name">CodeC</span>
        </a>
        <input id="nav-toggle" class="nav-toggle" type="checkbox" aria-hidden="true" tabindex="-1" />
        <label for="nav-toggle" class="nav-toggle-btn" aria-label="Toggle navigation">
          <span class="nav-toggle-btn__bar"></span>
          <span class="nav-toggle-btn__bar"></span>
          <span class="nav-toggle-btn__bar"></span>
        </label>
        <nav class="site-nav" aria-label="Primary">
          <a href="/#compare">Compare</a>
          <a href="/#benchmarks">Benchmarks</a>
          <a href="/#see-it">Live demo</a>
          <a href="/protocol-map/">Protocol map</a>
          <a href="/docs/">Docs</a>
          <a href="/changelog/">What's new</a>
          <a href="https://github.com/wdunn001/Codec" rel="noopener" class="site-nav__icon" aria-label="GitHub">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12.5C24 5.87 18.63.5 12 .5z"/>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <script is:inline>
      // Close the mobile nav when a link inside it is clicked. Pure-CSS
      // toggle handles open/close via the checkbox, but in-page anchors
      // (#compare, #benchmarks) don't unload the page, so the panel
      // would otherwise stay open after navigation.
      (function () {
        var t = document.getElementById("nav-toggle");
        if (!t) return;
        document.querySelectorAll(".site-nav a").forEach(function (a) {
          a.addEventListener("click", function () { t.checked = false; });
        });
      })();
    </script>

    <footer class="site-footer">
      <div class="container site-footer__row">
        <div>
          <span class="brand__name">CodeC</span>
          <span class="site-footer__muted"> &middot; computer to computer</span>
        </div>
        <div class="site-footer__links">
          <a href="https://github.com/wdunn001/Codec" rel="noopener">Codec</a>
          <a href="https://github.com/wdunn001/codec-maps" rel="noopener">codec-maps</a>
          <a href="mailto:licensing@quasarke.com">Licensing</a>
        </div>
        <div class="site-footer__muted">&copy; 2026 Quasarke LLC</div>
      </div>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(12px);
        background: color-mix(in srgb, var(--bg) 80%, transparent);
        border-bottom: 1px solid var(--border);
      }
      .site-header__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.875rem;
        padding-bottom: 0.875rem;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        font-family: var(--font-mono);
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .brand__name { font-size: 1rem; color: var(--fg); }
      .brand:hover .brand__name { color: var(--data); }

      .site-nav {
        display: inline-flex;
        align-items: center;
        gap: 1.5rem;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--fg-muted);
      }
      .site-nav a:hover { color: var(--fg); }
      .site-nav__icon {
        display: inline-flex;
        align-items: center;
        color: var(--fg-muted);
      }
      .site-nav__icon:hover { color: var(--fg); }

      /* Mobile nav toggle: hidden checkbox drives a label-button via :checked.
         Pure CSS, no JS hydration. Hamburger morphs into an X when open. */
      .nav-toggle { display: none; }
      .nav-toggle-btn {
        display: none;
        width: 44px;
        height: 44px;
        padding: 10px;
        cursor: pointer;
        border-radius: 6px;
        flex-direction: column;
        justify-content: space-between;
        align-items: stretch;
      }
      .nav-toggle-btn__bar {
        display: block;
        height: 2px;
        background: var(--fg-muted);
        border-radius: 2px;
        transition: transform 0.18s ease, opacity 0.18s ease, background-color 0.18s ease;
        transform-origin: center;
      }
      .nav-toggle-btn:hover .nav-toggle-btn__bar { background: var(--fg); }
      .nav-toggle:focus-visible + .nav-toggle-btn {
        outline: 2px solid var(--data);
        outline-offset: 2px;
      }

      @media (max-width: 760px) {
        .site-header__row { position: relative; }
        .nav-toggle-btn { display: inline-flex; }
        .site-nav {
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          padding: 0.5rem 1rem 1rem;
          background: color-mix(in srgb, var(--bg) 96%, transparent);
          backdrop-filter: blur(12px);
          border-bottom: 1px solid var(--border);
          font-size: 1rem;
          max-height: 0;
          overflow: hidden;
          opacity: 0;
          transition: max-height 0.22s ease, opacity 0.18s ease, padding 0.22s ease;
        }
        .site-nav a {
          padding: 0.875rem 0.25rem;
          border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
        }
        .site-nav a:last-child { border-bottom: none; }
        .site-nav__icon {
          /* GitHub icon needs its own padding inside the column */
          padding: 0.875rem 0.25rem;
        }
        .nav-toggle:checked ~ .site-nav {
          max-height: 24rem;
          opacity: 1;
          padding: 0.5rem 1rem 1rem;
        }
        .nav-toggle:checked ~ .nav-toggle-btn .nav-toggle-btn__bar:nth-child(1) {
          transform: translateY(10px) rotate(45deg);
        }
        .nav-toggle:checked ~ .nav-toggle-btn .nav-toggle-btn__bar:nth-child(2) {
          opacity: 0;
        }
        .nav-toggle:checked ~ .nav-toggle-btn .nav-toggle-btn__bar:nth-child(3) {
          transform: translateY(-10px) rotate(-45deg);
        }
      }

      .site-footer {
        margin-top: auto;
        border-top: 1px solid var(--border);
        padding: 2rem 0;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
      }
      .site-footer__row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
        color: var(--fg-muted);
      }
      .site-footer__links { display: inline-flex; gap: 1.25rem; }
      .site-footer__muted { color: var(--fg-faint); }
    </style>
  </body>
</html>
